{
  "version": 1,
  "tool": "cwebp",
  "required_version": "1.3.x or newer",
  "defaults": ["-quiet", "-q", "82", "-m", "6", "-metadata", "none", "-exact"],
  "images": [
    {
      "source": "public/img/bg-img/lotte_street_view.png",
      "output": "public/img/bg-img/lotte_street_view.webp",
      "width": 1024,
      "height": 1024
    },
    {
      "source": "public/img/bg-img/slide1.jpg",
      "output": "public/img/bg-img/slide1-card.webp",
      "width": 640,
      "height": 480
    },
    {
      "source": "public/img/bg-img/slide2.jpg",
      "output": "public/img/bg-img/slide2-card.webp",
      "width": 800,
      "height": 450
    },
    {
      "source": "public/img/bg-img/slide4.jpg",
      "output": "public/img/bg-img/slide4-card.webp",
      "width": 800,
      "height": 533
    },
    {
      "source": "public/img/bg-img/slide4.jpg",
      "output": "public/img/bg-img/slide4-wide.webp",
      "width": 1600,
      "height": 1067
    }
  ]
}
