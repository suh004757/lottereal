<!DOCTYPE html>
<html lang="ko"><head><meta charset="UTF-8">
<!-- Share-card template (1200x630). Render: python scripts/og_cards/render_og_cards.py (sets body data-show per type) -->
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@500;700;900&family=Inter:wght@600&display=swap" rel="stylesheet">
<style>
  html, body { margin: 0; width: 1200px; height: 630px; overflow: hidden; }
  body {
    position: relative; font-family: 'Noto Sans KR', sans-serif; color: #fff;
    background:
      radial-gradient(ellipse 60% 55% at 78% 100%, rgba(217,119,6,.38), transparent 70%),
      radial-gradient(ellipse 50% 60% at 8% 0%, rgba(42,74,117,.6), transparent 70%),
      linear-gradient(180deg, #0b1626 0%, #13263f 55%, #1E3A5F 100%);
  }
  .copy { position: absolute; left: 84px; top: 72px; width: 660px; z-index: 3; }
  .badge { display: inline-block; padding: 10px 22px; border-radius: 999px; border: 2px solid rgba(248,194,106,.6); color: #f8c26a; font-size: 26px; font-weight: 700; }
  h1 { margin: 28px 0 18px; font-size: 76px; line-height: 1.12; font-weight: 900; letter-spacing: -.04em; }
  h1 em { font-style: normal; background: linear-gradient(90deg, #fff, #fde7c2 50%, #f8c26a); -webkit-background-clip: text; background-clip: text; color: transparent; }
  p { margin: 0; font-size: 30px; line-height: 1.5; color: rgba(255,255,255,.8); font-weight: 500; }
  .brand { position: absolute; left: 84px; bottom: 50px; display: flex; align-items: center; gap: 14px; font-size: 30px; font-weight: 700; z-index: 3; text-shadow: 0 2px 12px rgba(5,12,22,.9); }
  .brand i { width: 14px; height: 14px; border-radius: 50%; background: #f8c26a; box-shadow: 0 0 0 6px rgba(248,194,106,.2); }
  .brand span { color: rgba(255,255,255,.65); font-family: Inter, sans-serif; font-weight: 600; font-size: 24px; margin-left: 8px; }
  .motif { position: absolute; right: 70px; top: 64px; width: 380px; height: 300px; z-index: 2; }
  .lr-hero-skyline { position: absolute; left: 0; right: 0; bottom: 0; width: 100%; height: 230px; opacity: .9; }
  .lh-star { fill: #fff; opacity: .6; } .lh-bld--back { fill: #1c3554; opacity: .85; } .lh-bld--front { fill: #0a1524; }
  .lh-tower { fill: #0d1a2c; stroke: rgba(248,194,106,.35); stroke-width: 1.2; } .lh-tower-edge { stroke: rgba(248,194,106,.28); }
  .lh-beacon { fill: #ef4444; } .lh-win { fill: #f8c26a; opacity: .85; } .lh-river { fill: #0a1524; } .lh-ripple { fill: rgba(248,194,106,.45); }
  .card { fill: rgba(255,255,255,.95); } .line { fill: #e2e8f0; } .amber { fill: #f8c26a; }
  .amber-s { fill: none; stroke: #f8c26a; stroke-width: 8; stroke-linecap: round; stroke-linejoin: round; }
  .navy-s { fill: none; stroke: #1E3A5F; stroke-width: 7; stroke-linecap: round; stroke-linejoin: round; }
  .ghost { fill: rgba(255,255,255,.16); }
  [data-type] { display: none; } body[data-show="market"] [data-type="market"], body[data-show="checklist"] [data-type="checklist"],
  body[data-show="guide"] [data-type="guide"], body[data-show="dispute"] [data-type="dispute"] { display: block; }
</style></head>
